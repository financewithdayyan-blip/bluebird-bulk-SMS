# Zoom Phone SMS — copy these into .env.local with real values
# (Zoom App Marketplace → Develop → Build App → Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Your Zoom Phone number in E.164 format, e.g. +12145550000
ZOOM_FROM_NUMBER=
# Email of the Zoom user the number is assigned to (or set ZOOM_USER_ID instead)
ZOOM_USER_EMAIL=

# Only these signed-in accounts may send SMS (comma-separated). Empty = any signed-in user.
ALLOWED_EMAILS=

# Incoming-SMS webhook (Zoom App Marketplace → your app → Feature → Event Subscriptions)
# Secret Token shown when you add the subscription; endpoint URL is <your-domain>/api/zoom-webhook
ZOOM_WEBHOOK_SECRET_TOKEN=
# The Supabase auth user id that owns all leads (this app is single-tenant on the Zoom side)
OWNER_USER_ID=
